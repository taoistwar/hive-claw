# ====================================================================
# hiveweb 环境变量（003 admin-center + 004 agent-runtime 合并）
# ====================================================================

# ---- 插件系统总开关 ----
# PLUGIN_SYSTEM_ENABLED=true
#   启用插件系统（默认）：S3 客户端必填，Plugin 上传/下载/调用及 s3.* capability 可用。
# PLUGIN_SYSTEM_ENABLED=false
#   关闭插件系统：S3 客户端跳过初始化，AWS_* 与 S3_BUCKET 可不填；
#   Plugin 相关接口（/api/plugins、/api/runtime/functions/:id/invoke 等）
#   及 s3.read / s3.write capability 返回 503 业务码 5031。
# 合法值：true/false/1/0/yes/no/off（不区分大小写），空值等同 true。
# PLUGIN_SYSTEM_ENABLED=true

# ---- Database / Cache / Storage（003 既有） ----
# HiveWeb 主进程账号。对 runtime_audit_logs 仅授 INSERT + SELECT，
# 显式撤销 UPDATE + DELETE；其他业务表按实际 CRUD 逐表授权。
DATABASE_URL=mysql://user:password@localhost:3306/hiveweb

# audit-retention 独占账号；仅授 runtime_audit_logs.DELETE。
# audit-retention 不会、也不得回退使用上面的 DATABASE_URL。
# 生产环境只放入 retention worker 的独立 Secret/env 文件，不放入 HiveWeb 服务环境。
# AUDIT_RETENTION_DATABASE_URL=mysql://audit_retention:password@localhost:3306/hiveweb

# 仅 dev-tools seed 使用：指向普通文件而不是密码本身；Unix 上须由当前
# 用户持有、权限为 0600 或更严格，且不得为软链接或有其他硬链接。
# 内容遵循正式管理员密码策略：6–20 个 Unicode code point，并同时含 ASCII 字母和数字。
# HIVEWEB_DEV_SEED_ADMIN_PHONE=<11-digit-development-phone>
# HIVEWEB_DEV_SEED_ADMIN_PASSWORD_FILE=/run/secrets/hiveweb-dev-seed-admin

# Redis 直连模式（默认；兼容原有 REDIS_URL 配置）
REDIS_MODE=direct
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=5000

# Redis Sentinel 模式：将 REDIS_MODE 改为 sentinel 后启用。
# 此模式忽略 REDIS_URL；REDIS_PASSWORD 是数据主节点密码，不是 Sentinel 密码。
# REDIS_MODE=sentinel
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_SENTINEL_NODES=10.0.0.1:26379,10.0.0.2:26379,10.0.0.3:26379
# REDIS_DATABASE=0
# REDIS_SENTINEL_REFRESH_MS=1000
# REDIS_USERNAME=
# REDIS_PASSWORD=
# Sentinel 自身启用 ACL/密码认证时再配置以下两项
# REDIS_SENTINEL_USERNAME=
# REDIS_SENTINEL_PASSWORD=

# 仅在 PLUGIN_SYSTEM_ENABLED=true 时必填；关闭插件系统时可不配置
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:9000
# Rustfs / MinIO 建议保持 true；仅在支持虚拟主机桶寻址的服务上按需设为 false。
# 合法值：true/false/1/0/yes/no/on/off（不区分大小写）；未设置时默认为 true。
AWS_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=hiveclaw

# ---- HTTP 服务（003 既有） ----
HIVEWEB_HOST=127.0.0.1
HIVEWEB_PORT=3300
CORS_ALLOWED_ORIGINS=*
RUST_LOG=info

# ---- 运行环境 ----
# APP_ENV=development  (开发环境，启用 DEBUG 日志和 POST body 日志)
# APP_ENV=test         (测试环境，同时启用普通控制台日志和文件日志)
# APP_ENV=production   (生产环境，仅 INFO 日志)
# 不设置时默认为 development

# ---- JWT / 登录策略（003 既有） ----
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_SEC=86400
RATE_LIMIT_MAX=180
LOGIN_LOCK_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION_SEC=900

# ====================================================================
# 004 Agent Runtime 新增（共 16 项）
# ====================================================================

# ---- Plugin 上传 & 调用（FR-005 / FR-030 / FR-031） ----
PLUGIN_MAX_BYTES=16777216             # Plugin WASM 上传体积上限 16 MB
PLUGIN_CALL_TIMEOUT_MS=30000          # 单次 Plugin 调用硬超时（Extism + Tokio wall-clock）
PLUGIN_CALL_MAX_MEMORY_MB=128         # WASM linear memory 上限
PLUGIN_CALL_FUEL=10000000000          # 非零 u64；Wasmtime fuel（防 CPU 死循环）

# ---- Instance Pool（FR-029 / research §2） ----
PLUGIN_POOL_MAX_PER_PLUGIN=8          # 每 Plugin 并发 invocation slot 上限
PLUGIN_POOL_MAX_TOTAL=64              # 全局并发 invocation slot 上限
PLUGIN_POOL_IDLE_TIMEOUT_SEC=600      # 空闲 CompiledPlugin 缓存 10 分钟回收
PLUGIN_POOL_ACQUIRE_TIMEOUT_MS=5000   # acquire 超时 → 5009 PoolBusy

# ---- Agent 编排 / 聊天（FR-023 / FR-027） ----
AGENT_MAX_HOPS=5                      # 单会话 Agent 路由跳数上限
CHAT_RETENTION_DAYS=30                # ChatMessage 保留天数（后台清理）
CHAT_RETENTION_INTERVAL_SEC=86400     # chat-retention 扫描间隔；必须为正整数
CHAT_SSE_MAX_CONCURRENT_PER_USER=1    # 单用户同时活跃 SSE 流数上限

# ---- LLM / 审计（FR-025 / FR-021 / research §7） ----
LLM_PRESETS_PATH=./llm_presets.toml   # 必须存在且恰好有一个有效 default；否则启动失败
# llm_presets.toml 中 provider 默认必须设置 api_key_env，并指向启动时存在且非空的变量。
# 唯一免认证形式：auth="none" + 显式合法 http(s) base_url，且不得同时设置 api_key_env。
# 单独省略 api_key_env 不表示免认证，变量名也不会被当作 API Key。
# OPENAI_API_KEY=<injected-by-your-secret-manager>
LLM_NODE_TIMEOUT_MS=25000             # 单 provider 节点 LLM 调用超时
LLM_CHAIN_TIMEOUT_MS=45000            # FallbackProvider 整链总耗时上限
AUDIT_RETENTION_DAYS=36500            # runtime_audit_logs 保留天数（默认 100 年，可调整）
AUDIT_RETENTION_INTERVAL_SEC=86400    # retention worker 扫描间隔（秒）

# ---- Capabilities Allowlist ----
# 仅精确 hostname；不支持前导点后缀别名或 wildcard。
NETWORK_HTTP_ALLOWLIST=wttr.in

# ---- 008 Agent Hook 配置管理（FR-011 / FR-007a） ----
HOOK_TIMEOUT_MS=10000                  # 单个 Hook 执行超时时间（默认 10 秒，FR-011）
HOOK_WEBHOOK_RETRY_MAX=3              # 仅 0..=3；0 禁用，无效值回退 3；退避固定 1/2/4s（FR-007a）

# ====================================================================
# 007 External Assistant API 新增
# ====================================================================

# 外部只读数据库（cloud_computer），用于校验用户和会员等级
# 不配置时 Assistant API 返回 "Assistant service unavailable"
EXTERNAL_DB_URL=mysql://user:password@43.140.221.181:3306/cloud_computer

# MD5 签名预共享密钥，调用方需以此生成 sign 参数
# 不在请求中传输，仅服务端持有
ASSISTANT_SECRET=change-me-to-a-random-secret
