# CORS Configuration
CORS_ALLOWED_ORIGINS=*

# Logging
RUST_LOG=info

# S3/Rustfs Configuration
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
