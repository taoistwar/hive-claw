# ====================================================================
# hiveweb 环境变量（003 admin-center + 004 agent-runtime 合并）
# ====================================================================

# ---- Database / Cache / Storage（003 既有） ----
DATABASE_URL=mysql://user:password@localhost:3306/hiveweb
REDIS_URL=redis://127.0.0.1:6379
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=hiveclaw

# ---- HTTP 服务（003 既有） ----
HIVWEB_HOST=127.0.0.1
HIVWEB_PORT=3000
CORS_ALLOWED_ORIGINS=*
RUST_LOG=info

# ---- JWT / 登录策略（003 既有） ----
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_SEC=86400
RATE_LIMIT_MAX=100
LOGIN_LOCK_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION_SEC=900

# ====================================================================
# 004 Agent Runtime 新增（共 15 项）
# ====================================================================

# ---- Plugin 上传 & 调用（FR-005 / FR-030 / FR-031） ----
PLUGIN_MAX_BYTES=16777216             # Plugin WASM 上传体积上限 16 MB
PLUGIN_CALL_TIMEOUT_MS=30000          # 单次 Plugin 调用硬超时（tokio 层）
PLUGIN_CALL_MAX_MEMORY_MB=128         # WASM linear memory 上限
PLUGIN_CALL_FUEL=10000000000          # Wasmtime fuel（防 CPU 死循环；与 timeout 并行）

# ---- Instance Pool（FR-029 / research §2） ----
PLUGIN_POOL_MAX_PER_PLUGIN=8          # 每 Plugin 缓存的实例上限
PLUGIN_POOL_MAX_TOTAL=64              # 全局实例上限
PLUGIN_POOL_IDLE_TIMEOUT_SEC=600      # 空闲实例 10 分钟回收
PLUGIN_POOL_ACQUIRE_TIMEOUT_MS=5000   # acquire 超时 → 5009 PoolBusy

# ---- Agent 编排 / 聊天（FR-023 / FR-027） ----
AGENT_MAX_HOPS=5                      # 单会话 Agent 路由跳数上限
CHAT_RETENTION_DAYS=30                # ChatMessage 保留天数（后台清理）
CHAT_SSE_MAX_CONCURRENT_PER_ADMIN=2   # 单管理员同时活跃 SSE 流数上限

# ---- LLM / 审计（FR-025 / FR-021 / research §7） ----
LLM_PRESETS_PATH=./llm_presets.toml   # LLM preset 配置文件路径
LLM_NODE_TIMEOUT_MS=25000             # 单 provider 节点 LLM 调用超时
LLM_CHAIN_TIMEOUT_MS=45000            # FallbackProvider 整链总耗时上限
AUDIT_RETENTION_DAYS=90               # runtime_audit_logs 保留天数
