# Database Configuration
DATABASE_URL=mysql://user:password@localhost:3306/hiveweb

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379

# Server Configuration
HIVWEB_HOST=127.0.0.1
HIVWEB_PORT=3000

# JWT Configuration
